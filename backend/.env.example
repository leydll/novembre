# configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGEZ_MOI
DB_NAME=novembre

# Secret pour la génération des tokens JWT
# IMPORTANT : Utilisez une chaîne aléatoire longue et complexe en production
JWT_SECRET=CHANGEZ_MOI_AVEC_UN_SECRET_ALEATOIRE_LONG_ET_COMPLEXE

# Port du serveur Express (optionnel, par défaut 5001)
PORT=5001

# Environnement d'exécution
# Options: development, production, test
# - development: Mode développement avec logs détaillés et erreurs complètes
# - production: Mode production avec sécurité renforcée (HTTPS, Secure cookies, logs minimaux)
# - test: Mode test pour l'exécution des tests Jest 
NODE_ENV=development

# URL de base pour redirection HTTPS en production
# Utilisée uniquement en production pour rediriger HTTP vers HTTPS de manière sécurisée
# Format: https://votre-domaine.com 
# Exemple: https://bakesomecaakes.example.com
# Laisser vide si non utilisé ou en développement
APP_BASE_URL=